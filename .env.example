APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./approvals.db

# The origin must match the host in submitted Harness execution URLs.
HARNESS_BASE_URL=https://app.harness.io
HARNESS_API_KEY=replace-with-a-dedicated-minimum-permission-api-key

# Local development only; never use the dev login in a deployed environment.
DEV_USER_EMAIL=approver@example.com
DEV_USER_NAME=Local UAT Approver
DEV_USER_ROLES=requester,uat_approver,auditor

# Required outside APP_ENV=development. Configure your OIDC provider.
OIDC_ISSUER=https://your-tenant.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
OIDC_ROLES_CLAIM=groups
OIDC_ROLE_MAP=
SESSION_HTTPS_ONLY=false

